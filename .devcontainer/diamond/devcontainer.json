{
  "name": "UltraZohm CPLD — Diamond",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../..",
    "target": "toolchain",
    "options": [
      "--platform=linux/amd64"
    ]
  },
  "runArgs": [
    "--network=host"
  ],
  "mounts": [
    "source=${localEnv:DIAMOND_HOST_ROOT},target=/opt/diamond,type=bind,readonly"
  ],
  "containerEnv": {
    "DIAMOND_ROOT": "/opt/diamond",
    "LM_LICENSE_FILE": "${localEnv:LM_LICENSE_FILE}"
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "postCreateCommand": "bash .devcontainer/setup.sh && check-diamond",
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "init": true
}
