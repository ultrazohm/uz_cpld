+// SPDX-License-Identifier: Apache-2.0
+#ifndef UZ_MACHXO2_BITSTREAM_HPP
+#define UZ_MACHXO2_BITSTREAM_HPP
+#include <cstdint>
+#include <stdexcept>
+#include <string>
+
+// Validate the compressed MachXO2 stream before any erase. Command framing,
+// prefix codes and CRC follow Project Trellis 3afe7b5, libtrellis/Bitstream.cpp;
+// frame geometry follows prjtrellis-db devices.json (MachXO2).
+// No configuration data is executed or allocated while validating it.
+class MachXO2Bitstream {
+    const std::string &data;
+    size_t pos;
+    uint16_t crc = 0;
+
+    void update(uint8_t value) {
+        for (int bit = 7; bit >= 0; --bit) {
+            const bool high = crc & 0x8000;
+            crc = uint16_t((crc << 1) | ((value >> bit) & 1));
+            if (high) crc ^= 0x8005;
+        }
+    }
+    uint8_t byte(bool command = false) {
+        if (pos >= data.size()) throw std::runtime_error("Truncated MachXO2 bitstream");
+        const uint8_t value = uint8_t(data[pos++]);
+        if (!command || value != 0xff) update(value);
+        return value;
+    }
+    uint32_t word(unsigned count) {
+        uint32_t value = 0;
+        while (count--) value = (value << 8) | byte();
+        return value;
+    }
+    void zeros(unsigned count) {
+        if (word(count) != 0) throw std::runtime_error("Unsupported MachXO2 command operands");
+    }
+    void checksum() {
+        update(0); update(0);
+        const uint16_t expected = crc;
+        const uint16_t actual = uint16_t(word(2));
+        if (actual != expected) throw std::runtime_error("MachXO2 bitstream CRC mismatch");
+        crc = 0;
+    }
+    void compressed_frame(unsigned size) {
+        uint8_t buffer = 0;
+        unsigned remaining = 0;
+        auto bit = [&]() {
+            if (!remaining) { buffer = byte(); remaining = 8; }
+            return (buffer >> --remaining) & 1;
+        };
+        // Each prefix produces exactly one byte: 0, 10iiii, or 11vvvvvvvv.
+        // Values need not be materialized to validate length and wire CRC.
+        for (unsigned i = 0; i < size; ++i) {
+            if (bit()) {
+                const unsigned count = bit() ? 8 : 4;
+                for (unsigned j = 0; j < count; ++j) bit();
+            }
+        }
+        if (remaining && (buffer & ((1u << remaining) - 1)))
+            throw std::runtime_error("Nonzero compressed frame padding");
+    }
+    void geometry(uint32_t id, unsigned &frames, unsigned &frame_bytes) {
+        // HC and ZE variants have identical frame geometry; density is bits 14:12.
+        const unsigned density = (id >> 12) & 7;
+        if ((id & ~0x0000f000u) != 0x012b0043 || density > 5)
+            throw std::runtime_error("Unsupported MachXO2 bitstream IDCODE");
+        static const unsigned counts[] = {186, 215, 333, 420, 623, 770};
+        static const unsigned bytes[] = {64, 112, 136, 160, 200, 256};
+        frames = counts[density];
+        frame_bytes = bytes[density]; // Includes compression's 64-bit alignment.
+    }
+public:
+    uint32_t idcode = 0, usercode = 0;
+    MachXO2Bitstream(const std::string &input, size_t start): data(input), pos(start) {
+        bool reset = false, identified = false, dictionary = false;
+        bool address = false, payload = false, user = false, done = false, ebr = false;
+        unsigned frames = 0, frame_bytes = 0;
+        while (pos < data.size()) {
+            const uint8_t cmd = byte(true);
+            if (cmd == 0xff) continue;
+            if (done) throw std::runtime_error("Data after MachXO2 DONE command");
+            switch (cmd) {
+            case 0x3b: // LSC_RESET_CRC
+                if (identified) throw std::runtime_error("Unexpected CRC reset");
+                zeros(3); crc = 0; reset = true; break;
+            case 0xe2: // VERIFY_ID
+                if (!reset || identified) throw std::runtime_error("Unexpected IDCODE command");
+                zeros(3); idcode = word(4); geometry(idcode, frames, frame_bytes);
+                identified = true; break;
+            case 0x22: // LSC_PROG_CNTRL0 (also repeated near end by Diamond/Trellis)
+                if (!identified) throw std::runtime_error("Control before IDCODE");
+                zeros(3); word(4); break;
+            case 0x79: // SPI_MODE
+                if (identified) throw std::runtime_error("Unexpected SPI mode command");
+                byte(); zeros(2); break;
+            case 0x02: { // LSC_WRITE_COMP_DIC
+                if (!identified || payload || dictionary) throw std::runtime_error("Unexpected compression dictionary");
+                const uint8_t flags = byte();
+                if (flags & ~0x80u) throw std::runtime_error("Unsupported dictionary flags");
+                zeros(2); word(4); word(4);
+                if (flags & 0x80) checksum();
+                dictionary = true; break;
+            }
+            case 0x46: // LSC_INIT_ADDRESS
+                if (!identified || payload || address) throw std::runtime_error("Unexpected frame address");
+                zeros(3); address = true; break;
+            case 0xb8: { // LSC_PROG_INCR_CMP
+                if (!identified || !dictionary || !address || payload)
+                    throw std::runtime_error("Incomplete compressed bitstream header");
+                const uint8_t flags = byte();
+                const unsigned count = word(2);
+                if (!(flags & 0x80) || count != frames)
+                    throw std::runtime_error("Invalid MachXO2 frame count or missing CRC");
+                for (unsigned frame = 0; frame < count; ++frame) {
+                    compressed_frame(frame_bytes);
+                    if (!(flags & 0x40) || frame + 1 == count) checksum();
+                    for (unsigned i = 0; i < (flags & 15); ++i)
+                        if (byte() != 0xff) throw std::runtime_error("Invalid frame dummy byte");
+                }
+                payload = true; break;
+            }
+            case 0xc2: { // ISC_PROGRAM_USERCODE
+                if (!payload || user) throw std::runtime_error("Unexpected USERCODE command");
+                const uint8_t flags = byte();
+                if (flags != 0x80) throw std::runtime_error("USERCODE requires CRC");
+                zeros(2); usercode = word(4); checksum(); user = true; break;
+            }
+            case 0xf6: // LSC_EBR_ADDRESS
+                if (!payload || ebr) throw std::runtime_error("Unexpected EBR address");
+                zeros(3); word(4); ebr = true; break;
+            case 0xb2: { // LSC_EBR_WRITE, 72-bit frames, CRC at end
+                if (!ebr) throw std::runtime_error("EBR data without address");
+                const uint8_t flags = byte();
+                const unsigned count = word(2);
+                if (flags != 0xd0 || count == 0 || count > 128)
+                    throw std::runtime_error("Unsupported MachXO2 EBR frame format");
+                for (unsigned i = 0; i < count * 9; ++i) byte();
+                checksum(); ebr = false; break;
+            }
+            case 0xa2: // LSC_PROG_SED_CRC
+                if (!payload) throw std::runtime_error("SED before configuration data");
+                zeros(3); word(4); break;
+            case 0xce: // ISC_PROGRAM_SECURITY
+                if (!payload) throw std::runtime_error("Security before configuration data");
+                zeros(3); break;
+            case 0x5e: { // ISC_PROGRAM_DONE
+                if (!payload || !user || ebr) throw std::runtime_error("Incomplete MachXO2 configuration");
+                const uint8_t flags = byte();
+                if (flags & ~0x80u) throw std::runtime_error("Unsupported DONE flags");
+                zeros(2);
+                if (flags & 0x80) checksum();
+                done = true; break;
+            }
+            default:
+                throw std::runtime_error("Unsupported command in compressed MachXO2 bitstream");
+            }
+        }
+        if (!done) throw std::runtime_error("Missing MachXO2 DONE command");
+    }
+};
+#endif
