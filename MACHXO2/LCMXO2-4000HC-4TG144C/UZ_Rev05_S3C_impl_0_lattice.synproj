-propagate_constants 1
-remove_duplicate_regs 1
-mux_style Auto
-max_fanout 1000
-fsm_encoding_style Auto
-twr_paths 3
-fix_gated_clocks 1
-loop_limit 1950




-use_io_insertion 1
-resolve_mixed_drivers 0
-use_io_reg auto


-lpf 1
-lib "work" -vhd "C:/lscc/diamond/3.13/bin/nt64/Power_on_debounce.vhd"
-top Powerup_V0


-p "C:/lscc/diamond/3.13/ispfpga/xo2c00/data" "C:/lscc/diamond/3.13/bin/nt64/impl_0" "C:/lscc/diamond/3.13/bin/nt64"

