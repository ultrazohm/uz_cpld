+// SPDX-License-Identifier: Apache-2.0
+#ifndef UZ_MACHXO2_IDENTITY_HPP
+#define UZ_MACHXO2_IDENTITY_HPP
+#include <cstdint>
+#include <exception>
+#include <stdexcept>
+#include <iostream>
+struct MachXO2Identity {
+    uint32_t idcode, flash_usercode, sram_usercode;
+    uint64_t traceid;
+};
+// Never enter offline configuration or issue erase/program/refresh instructions.
+// Mark transparent access as owned BEFORE enabling it, so partial failures clean up.
+template<typename Read, typename Enable, typename Disable, typename Bypass>
+MachXO2Identity read_machxo2_identity(Read read, Enable enable, Disable disable, Bypass bypass) {
+    MachXO2Identity result{};
+    bool owned = false;
+    try {
+        if (read(0x3c, 4) & (1u << 9))
+            throw std::runtime_error("Configuration interface already enabled; refusing to alter its state");
+        result.idcode = read(0xe0, 4);
+        result.sram_usercode = read(0xc0, 4);
+        owned = true;
+        enable();
+        result.flash_usercode = read(0xc0, 4);
+        disable();
+        owned = false;
+        result.traceid = read(0x19, 8);
+        bypass();
+        return result;
+    } catch (...) {
+        auto original = std::current_exception();
+        if (owned) {
+            try { disable(); } catch (...) { std::cerr << "Failed to leave transparent access after read failure\n"; }
+        }
+        try { bypass(); } catch (...) { std::cerr << "Failed to restore JTAG BYPASS after read failure\n"; }
+        std::rethrow_exception(original);
+    }
+}
+#endif
