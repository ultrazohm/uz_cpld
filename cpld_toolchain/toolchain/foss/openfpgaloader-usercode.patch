+        },
+        [this]() {
+            if (!DisableISC()) throw std::runtime_error("Could not leave transparent Flash access");
+        },
+        [this]() {
+            wr_rd(BYPASS, NULL, 0, NULL, 0);
+            _jtag->set_state(Jtag::RUN_TEST_IDLE);
+            _jtag->flush();
+        });
+}
