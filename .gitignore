# Lattice Diamond / ispLEVER generated files.
# Keep HDL, constraints (.lpf/.ldc/.lci/.sdc/.fdc), projects (.ldf/.syn/.prj),
# strategies (.sty), IP configuration/netlists (.ipx/.lpc/.edn/.edf),
# Programmer chains (.xcf), scripts (.tcl), and mapping tables (.csv).
# Keep programming deliverables (.jed/.bit/.svf/.xsvf) available for versioning.
# Do not ignore entire implementation folders: they can contain source files.

# Local GUI state, recovery, and temporary files
.build_status
.run_manager.ini
.recovery
.setting.ini
.spread_sheet.ini
.spreadsheet_view.ini
