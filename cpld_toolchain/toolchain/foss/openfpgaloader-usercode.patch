+        throw std::runtime_error("Identity read requires MachXO2");
+    return read_machxo2_identity(
+        [this](uint8_t command, unsigned length) {
+            uint8_t bytes[8] = {};
+            wr_rd(command, NULL, 0, bytes, length);
+            _jtag->set_state(Jtag::RUN_TEST_IDLE);
+            return uz_little_endian(bytes, length);
+        },
+        [this]() {
+            uint8_t flash = 0x08;
+            wr_rd(ISC_ENABLE_TRANSPARENT, &flash, 1, NULL, 0);
+            _jtag->set_state(Jtag::RUN_TEST_IDLE);
+            _jtag->toggleClk(1000);
+            if (!pollBusyFlag() || !checkStatus(REG_STATUS_ISC_EN, REG_STATUS_ISC_EN))
