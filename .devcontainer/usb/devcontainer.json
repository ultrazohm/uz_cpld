{
  "name": "UltraZohm CPLD USB programmer",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../..",
    "options": ["--platform=linux/amd64"],
    "target": "toolchain"
  },
  "overrideCommand": false,
  "containerEnv": {
    "LM_LICENSE_FILE": "${localEnv:LM_LICENSE_FILE}"
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": ["openai.chatgpt", "teros-technology.teroshdl"],
      "settings": {"terminal.integrated.defaultProfile.linux": "bash"}
    }
  },
  "init": true,
  "initializeCommand": ["bash", "${localWorkspaceFolder}/.devcontainer/prepare-host.sh"],
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/setup-network.sh",
  "waitFor": "postStartCommand",
  "runArgs": [
    "--platform=linux/amd64",
    "--network=name=bridge,mac-address=10:91:d1:3d:14:ae",
    "--cap-add=NET_ADMIN",
    "--mount",
    "type=bind,source=${localWorkspaceFolder}/.devcontainer/.local/diamond,target=/opt/diamond,readonly",
    "--mount",
    "type=bind,source=/dev/bus/usb,target=/dev/bus/usb",
    "--device-cgroup-rule=c 189:* rwm",
    "--group-add=${localEnv:USB_DEVICE_GID:46}"
  ]
}
