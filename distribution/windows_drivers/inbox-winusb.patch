--- a/libwdi/libwdi.c
+++ b/libwdi/libwdi.c
@@ -622,6 +622,23 @@
 		goto out;
 	}
 
+#if defined(UZ_INBOX_WINUSB)
+    // UltraZohm modification: package metadata, not the version of an embedded
+    // Microsoft binary. The INF delegates driver/service installation to Windows.
+    if (driver_type == WDI_WINUSB) {
+        SYSTEMTIME date = { 2020, 1, 0, 1, 0, 0, 0, 0 };
+        FILETIME stamp;
+        memset(driver_info, 0, sizeof(*driver_info));
+        driver_info->dwSignature = 0xFEEF04BD;
+        driver_info->dwFileVersionMS = 10 << 16;
+        if (!SystemTimeToFileTime(&date, &stamp)) { r = WDI_ERROR_OTHER; goto out; }
+        driver_info->dwFileDateMS = stamp.dwHighDateTime;
+        driver_info->dwFileDateLS = stamp.dwLowDateTime;
+        r = WDI_SUCCESS;
+        goto out;
+    }
+#endif
+
 	// No need to extract the version again if available
 	if (driver_version[driver_type].dwSignature != 0) {
 		memcpy(driver_info, &driver_version[driver_type], sizeof(VS_FIXEDFILEINFO));
@@ -723,7 +740,10 @@
 
 	switch (driver_type) {
 	case WDI_WINUSB:
-#if defined(WDK_DIR)
+#if defined(UZ_INBOX_WINUSB)
+        GET_WINDOWS_VERSION;
+        return nWindowsVersion >= WINDOWS_10;
+#elif defined(WDK_DIR)
 		return TRUE;
 #else
 		return FALSE;
