#$ TOOL SCH2BLF 2.1.00.02 
#$ TITLE io_pins.bls 
#$ PROPERTY LATTICE OSCTIMER TIMER_DIV = 1048576;
#$ MODULE io_pins 
#$ PINS 22  P g f e d c b a bs_LSB bs_MSB scl sda y0 y1 y2 y3 y4 y5 y6 \
#   y7 Adapter FPGA
#$ NODES 42 data_1_0_ data_1_1_ data_1_2_ data_1_3_ data_1_4_  \
#  data_1_5_ data_1_6_ data_1_7_ read_req data_valid N_12  \
#  data_to_master_0_ data_to_master_1_ data_to_master_2_  \
#  data_to_master_3_ data_to_master_4_ data_to_master_5_  \
#  data_to_master_6_ data_to_master_7_ i2c_data_0_ i2c_data_1_  \
#  i2c_data_2_ i2c_data_3_ i2c_data_4_ i2c_data_5_ i2c_data_6_  \
#  i2c_data_7_ TIMEROUT N_4 N_5 N_6 N_7 N_8 N_9 N_10 N_11 OSCOUT  \
#  DYNOSCDIS TIMERRES N_1 N_2 N_3 
#$ NODES 4 I15>TIMEROUT I15>OSCOUT I15>TIMERRES I15>DYNOSCDIS
#$ INTERFACE concat8 16 u0'i' u1'i' u2'i' u3'i' u4'i' u5'i' u6'i' \
#   u7'i' y_0_'o' y_1_'o' y_2_'o' y_3_'o' y_4_'o' y_5_'o' y_6_'o' \
#   y_7_'o'
#$ INTERFACE g_bidir 4 I'i' OE'i' FBK'o' O'io'
#$ INTERFACE g_inv 2 A'i' YN'o'
#$ INTERFACE gnd 1 x'o'
#$ INTERFACE i2c_minion 32 clk'i' data_to_master_0_'i' \
#   data_to_master_1_'i' data_to_master_2_'i' data_to_master_3_'i' \
#   data_to_master_4_'i' data_to_master_5_'i' data_to_master_6_'i' \
#   data_to_master_7_'i' rst'i' byte_step_LSB'o' byte_step_MSB'o' \
#   data_from_master_0_0_'o' data_from_master_0_1_'o' \
#   data_from_master_0_2_'o' data_from_master_0_3_'o' \
#   data_from_master_0_4_'o' data_from_master_0_5_'o' \
#   data_from_master_0_6_'o' data_from_master_0_7_'o' \
#   data_from_master_1_0_'o' data_from_master_1_1_'o' \
#   data_from_master_1_2_'o' data_from_master_1_3_'o' \
#   data_from_master_1_4_'o' data_from_master_1_5_'o' \
#   data_from_master_1_6_'o' data_from_master_1_7_'o' data_valid'o' \
#   read_req'o' scl'io' sda'io'
#$ EXTERNAL osctimer 4 DYNOSCDIS'i' TIMERRES'i' OSCOUT'o' TIMEROUT'o'
#$ INTERFACE slice8 16 data_0_'i' data_1_'i' data_2_'i' data_3_'i' \
#   data_4_'i' data_5_'i' data_6_'i' data_7_'i' y0'o' y1'o' y2'o' \
#   y3'o' y4'o' y5'o' y6'o' y7'o'
#$ INTERFACE source 8 y0'o' y1'o' y2'o' y3'o' y4'o' y5'o' y6'o' y7'o'
#$ INSTANCE I10 concat8 16 N_4 N_5 N_6 N_7 N_8 N_9 N_10 N_11 \
#   data_to_master_0_ data_to_master_1_ data_to_master_2_ \
#   data_to_master_3_ data_to_master_4_ data_to_master_5_ \
#   data_to_master_6_ data_to_master_7_
#$ PRIMITIVE I4 g_bidir 4 N_1 y0 N_2 Adapter
#$ PRIMITIVE I5 g_bidir 4 N_2 N_3 N_1 FPGA
#$ PRIMITIVE I1 g_inv 2 y0 N_3
#$ PRIMITIVE I20 gnd 1 N_12
#$ INSTANCE I19 i2c_minion 32 OSCOUT data_to_master_0_ \
#   data_to_master_1_ data_to_master_2_ data_to_master_3_ \
#   data_to_master_4_ data_to_master_5_ data_to_master_6_ \
#   data_to_master_7_ N_12 bs_LSB bs_MSB i2c_data_0_ i2c_data_1_ \
#   i2c_data_2_ i2c_data_3_ i2c_data_4_ i2c_data_5_ i2c_data_6_ \
#   i2c_data_7_ data_1_0_ data_1_1_ data_1_2_ data_1_3_ data_1_4_ \
#   data_1_5_ data_1_6_ data_1_7_ data_valid read_req scl sda
#$ INSTANCE I15 osctimer 4 I15>DYNOSCDIS I15>TIMERRES I15>OSCOUT \
#   I15>TIMEROUT
#$ INSTANCE I21 slice8 16 i2c_data_0_ i2c_data_1_ i2c_data_2_ \
#   i2c_data_3_ i2c_data_4_ i2c_data_5_ i2c_data_6_ i2c_data_7_ y0 \
#   y1 y2 y3 y4 y5 y6 y7
#$ INSTANCE I22 slice8 16 data_1_0_ data_1_1_ data_1_2_ data_1_3_ \
#   data_1_4_ data_1_5_ data_1_6_ data_1_7_ a b c d e f g P
#$ INSTANCE I23 source 8 N_4 N_5 N_6 N_7 N_8 N_9 N_10 N_11
.model io_pins

.inputs  I15>TIMEROUT.BLIF I15>OSCOUT.BLIF TIMERRES.BLIF \
   DYNOSCDIS.BLIF
.outputs  TIMEROUT OSCOUT I15>TIMERRES I15>DYNOSCDIS
.names I15>TIMEROUT.BLIF TIMEROUT
1 1

.names I15>OSCOUT.BLIF OSCOUT
1 1

.names TIMERRES.BLIF I15>TIMERRES
1 1
.names DYNOSCDIS.BLIF I15>DYNOSCDIS
1 1
.end
