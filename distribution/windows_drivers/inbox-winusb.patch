--- a/configure.ac
+++ b/configure.ac
@@ -17,6 +17,13 @@
 AM_PROG_CC_C_O
 AC_DEFINE([_GNU_SOURCE], [], [Use GNU extensions])
 
+AC_ARG_ENABLE([inbox-winusb],
+    [AS_HELP_STRING([--enable-inbox-winusb], [use Windows 10/11 inbox WinUSB without WDK redistributables])],
+    [enable_inbox_winusb=$enableval], [enable_inbox_winusb=no])
+if test "x$enable_inbox_winusb" = "xyes"; then
+    AC_DEFINE([UZ_INBOX_WINUSB], [1], [Use Windows inbox WinUSB without coinstallers])
+fi
+
 AC_ARG_WITH([wdkdir],
