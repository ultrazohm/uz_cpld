{
  "name": "UltraZohm CPLD — documentation and simulation",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "options": [
      "--platform=linux/amd64"
    ],
    "target": "toolchain"
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "init": true,
  "postCreateCommand": "bash .devcontainer/setup.sh"
}
