#$ TOOL ispLEVER Classic 2.1.00.02.49.20
#$ DATE Mon Mar 22 15:48:00 2021
#$ TITLE io_pins.bls 
#$ MODULE io_pins
#$ PINS 3 IOselector Adapter'io'  FPGA'io' 
#$ NODES 3 N_4'o'  N_5'o'  N_6'o' 
.model io_pins
.inputs N_6.BLIF IOselector.BLIF Adapter.PIN.BLIF N_5.BLIF N_4.BLIF \
FPGA.PIN.BLIF
.outputs N_5 Adapter Adapter.OE N_6 FPGA FPGA.OE N_4
\

.subckt g_bidir I.BLIF=N_6.BLIF OE.BLIF=IOselector.BLIF O.PIN.BLIF=Adapter.PIN.BLIF \
 FBK=N_5 O=Adapter O.OE=Adapter.OE
\

.subckt g_bidir I.BLIF=N_5.BLIF OE.BLIF=N_4.BLIF O.PIN.BLIF=FPGA.PIN.BLIF FBK=N_6 \
 O=FPGA O.OE=FPGA.OE

.subckt g_inv A.BLIF=IOselector.BLIF YN=N_4
.end
.model g_bidir
.inputs OE.BLIF I.BLIF O.PIN.BLIF
.outputs O FBK O.OE
.names I.BLIF O
1 1
0 0
.names O.PIN.BLIF FBK
1 1
0 0
.names OE.BLIF O.OE
1 1
0 0
.end
.model g_inv
.inputs A.BLIF
.outputs YN
.names A.BLIF YN
0 1
1 0
.end
