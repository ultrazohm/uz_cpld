+// SPDX-License-Identifier: Apache-2.0
+#ifndef UZ_CHECKED_IO_HPP
+#define UZ_CHECKED_IO_HPP
+#include <cstdint>
+#include <stdexcept>
+
+inline void uz_check_write(int actual, int expected) {
+    if (actual != expected) throw std::runtime_error("Incomplete FTDI write; operation aborted without replay");
+}
+template<typename Read, typename Expired>
+int uz_read_exact(uint8_t *buffer, int length, Read read, Expired expired) {
+    int offset = 0;
+    while (offset < length) {
+        if (expired()) throw std::runtime_error("FTDI read timed out");
+        int n = read(buffer + offset, length - offset);
+        if (n < 0 || n > length - offset) throw std::runtime_error("FTDI read failed");
+        offset += n;
+    }
+    return offset;
+}
+inline uint64_t uz_little_endian(const uint8_t *bytes, unsigned length) {
+    if (length > 8) throw std::runtime_error("Invalid register width");
+    uint64_t value = 0;
+    for (unsigned i = 0; i < length; ++i) value |= uint64_t(bytes[i]) << (8 * i);
+    return value;
+}
+#endif
